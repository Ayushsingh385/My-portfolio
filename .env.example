# Environment Variables for Portfolio Website
# Copy this file to .env.local and fill in your values

# EmailJS Configuration (for contact form)
# Get these values from your EmailJS dashboard: https://www.emailjs.com/
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Site URL (used for SEO meta tags)
NEXT_PUBLIC_SITE_URL=https://your-portfolio-url.com

# Analytics (optional)
NEXT_PUBLIC_GA_ID=your_google_analytics_i